{
  "name": "triangle-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "check": "node scripts/check.mjs && npm run typecheck:tests && npm run build",
    "preview": "vite preview --host",
    "snap": "node scripts/snap.mjs",
    "test": "playwright test",
    "test:fast": "playwright test --project=mobile-safari"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
